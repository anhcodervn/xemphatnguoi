APP_NAME=XemPhatNguoi.vn
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Discord rooms (create these five channels and one webhook in each channel)
# #xpn-ops      = heartbeat, failed queue jobs, provider/search incidents, security and recovery
# #xpn-activity = new registrations and account lifecycle events
# #xpn-sales    = successful recharges, wallet and revenue events
# #xpn-support  = support messages and contact feedback
# #xpn-staging  = every report from non-production environments
DISCORD_WEBHOOK_OPS=
DISCORD_WEBHOOK_ACTIVITY=
DISCORD_WEBHOOK_SALES=
DISCORD_WEBHOOK_SUPPORT=
DISCORD_WEBHOOK_STAGING=

# Legacy aliases (optional during migration; canonical rooms above take priority)
DISCORD_WEBHOOK_QUEUE=
DISCORD_WEBHOOK_INFO=
DISCORD_WEBHOOK_SECURITY=
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_RECOVERED=
DISCORD_WEBHOOK_PROVIDER=
DISCORD_WEBHOOK_FEEDBACK=

# Discord bot / server context
DISCORD_BOT_NAME="XemPhatNguoi Monitor"
DISCORD_BOT_AVATAR_URL=
DISCORD_SERVER_NAME=
DISCORD_SERVER_IP=
DISCORD_SERVER_ROLE=app
DISCORD_SERVER_REGION=

# Example production values
# DISCORD_BOT_NAME="XemPhatNguoi Production"
# DISCORD_SERVER_NAME="prod-app-01"
# DISCORD_SERVER_IP="10.10.1.15"
# DISCORD_SERVER_ROLE="app"
# DISCORD_SERVER_REGION="sgp-1"

API_LOG_RETENTION_DAYS=30

TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
AUTOCRON_INTERNAL_KEY=

VITE_APP_NAME="${APP_NAME}"

TRAFFIC_FINE_SOURCE=xephatnguoi
XEPHATNGUOI_API_URL=https://api.xephatnguoi.com/v1/search
XEPHATNGUOI_API_TOKEN=
XEPHATNGUOI_TIMEOUT=10
XEPHATNGUOI_CONNECT_TIMEOUT=3
XEPHATNGUOI_RETRY_TIMES=2
XEPHATNGUOI_RETRY_SLEEP_MS=200
TRAFFIC_FINE_CACHE_STORE=redis
TRAFFIC_FINE_CACHE_TTL=86400
TRAFFIC_FINE_ERROR_CACHE_TTL=60
TRAFFIC_FINE_RATE_LIMIT_PER_MINUTE=20
TRAFFIC_FINE_API_REQUEST_PRICE=20
TRAFFIC_FINE_LOCK_SECONDS=15
TRAFFIC_FINE_LOCK_WAIT_SECONDS=3

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAME=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
